// smart_feedback integration handler - DO NOT DUPLICATE
// Added by automation: emits suggestions from smart_feedback and runs master_plan.py on demand
(function(){
  try {
    
    const cp = require("child_process");
    const path = require("path");
    const SMART_DIR = path.join(__dirname, "smart_feedback");
    const PRIORITY_FILE = path.join(SMART_DIR, "logs", "priority_queue.json");
    const MASTER = path.join(SMART_DIR, "master_plan.py");

    // Fallback suggestions if priority file missing
    const FALLBACK = [
      { path: "/api/approvals", description: "List approval requests." },
      { path: "/api/approvals/{id}", description: "Approval by id." },
      { path: "/api/approvals/{id}/approve", description: "Approve endpoint." }
    ];

    function loadPriorities() {
      try {
        if (fs.existsSync(PRIORITY_FILE)) {
          const txt = fs.readFileSync(PRIORITY_FILE, "utf8").trim();
          if (!txt) return FALLBACK;
          const parsed = JSON.parse(txt);
          // transform into suggestions array
          const arr = Object.keys(parsed).map(k => ({ path: k, description: `Priority ${parsed[k]}` }));
          return arr.length ? arr : FALLBACK;
        } else {
          return FALLBACK;
        }
      } catch(e) {
        console.error("smart_feedback: loadPriorities error", e);
        return FALLBACK;
      }
    }

    // Ensure we only install handler once
    if (io && !io.__smart_feedback_installed) {
      io.__smart_feedback_installed = true;

      io.on("connection", socket => {
        try {
          const suggestions = loadPriorities();
          socket.emit("suggestions", { paths: suggestions });
          socket.on("runSmartCycle", () => {
            // spawn python master_plan.py if present
            if (fs.existsSync(MASTER)) {
              const py = process.platform === "win32" ? "python" : "python3";
              const runner = cp.spawn(py, [MASTER], { cwd: SMART_DIR, stdio: ["ignore", "pipe", "pipe"] });
              let out = "", err = "";
              runner.stdout.on("data", d => { out += d.toString(); });
              runner.stderr.on("data", d => { err += d.toString(); });
              runner.on("close", code => {
                // reload priorities and notify clients
                const results = { code: code, out: out.trim(), err: err.trim() };
                try { const suggestions = loadPriorities(); io.emit("suggestions", { paths: suggestions }); } catch(e){}
                io.emit("smartCycleComplete", results);
                console.log("smart_feedback: runSmartCycle finished", results && results.code);
              });
            } else {
              socket.emit("smartCycleComplete", { code: 127, err: "master_plan.py missing" });
            }
          });
        } catch(e) {
          console.error("smart_feedback: connection handler error", e);
        }
      });

      console.log("smart_feedback integration handler installed");
    }
  } catch(e) {
    console.error("smart_feedback handler installation error", e);
  }
})();




