# ============================================================
# ?? Codex .gitignore — v0.9
# Ensures clean repository alignment
# ============================================================

# System and environment
.vscode/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.log
*.tmp
*.bak
*.swp

# Backups and archives
backups_reorg/
*.zip
*.tar
*.gz

# OS and OneDrive artifacts
Thumbs.db
desktop.ini
~$*
*.lnk

# Local test output
*.csv
*.json
*.cache
*.dat

# End of Codex .gitignore

# Allow Codex logs and handoffs to be tracked
!codex/logs/**
!codex/handoff/**
!codex/evolution/**
